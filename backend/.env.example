# ===============================================
# MediTrack+ Backend Environment Configuration Template
# ===============================================

# App Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# MongoDB Atlas Cloud Database (Primary Architecture)
# Format: mongodb+srv://<username>:<password>@<cluster-domain>.mongodb.net/?retryWrites=true&w=majority
# Replace with your actual MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=meditrack_plus

# Optional Developer Fallback (Local MongoDB instance if offline):
# MONGODB_URI=mongodb://localhost:27017

# JWT Authentication
# Generate a strong random 256-bit secret key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_with_your_strong_generated_secret_key_in_env_file
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Caregiver Business Rules
CAREGIVER_MISSED_THRESHOLD=2

# CORS Configuration
CORS_ORIGINS=*

# Password Recovery & Abuse Protection (Phase 12.1)
RESET_TOKEN_EXPIRE_MINUTES=15
RESET_TOKEN_MAX_ATTEMPTS=5
RESET_RATE_LIMIT_PER_HOUR=3
# Server-side secret pepper for HMAC-SHA256 OTP hashing (generate a strong random 256-bit key):
RESET_TOKEN_PEPPER=replace_with_your_strong_reset_token_pepper_secret_in_env_file

# ===============================================
# Email & Alerts Configuration (Phase 11 & 12.3)
# ===============================================
# Set to 'smtp' for real email delivery (production/staging) or 'mock' for in-memory recording (tests/dev)
EMAIL_BACKEND=mock
EMAIL_ENABLED=True

# SMTP Server Details (Example: Brevo, SendGrid, Mailgun, Amazon SES, or Gmail App Password)
# Standard STARTTLS uses port 587; Direct SSL uses port 465
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_or_api_key
SMTP_PASSWORD=your_smtp_password_or_app_secret
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=15

# Sender Identification
EMAIL_FROM_EMAIL=noreply@meditrack.health
EMAIL_FROM_NAME=MediTrack+ Medication Safety

# Automation & Background Cron Security (Phase 11)
# Generate a strong random key to authorize scheduled adherence report runs
CRON_SECRET_KEY=replace_with_strong_random_cron_secret_key


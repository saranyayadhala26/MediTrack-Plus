# ===============================================
# MediTrack+ Backend Environment Configuration
# ===============================================

# App Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas cluster URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=meditrack_plus

# JWT Authentication
# Generate a strong 256-bit secret key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=meditrack_dev_secret_key_super_secure_replace_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Caregiver Settings
CAREGIVER_MISSED_THRESHOLD=2

# CORS Allowed Origins (Comma separated or * for dev)
CORS_ORIGINS=*

# MediTrack+ Mobile Environment Configuration
# For Android Emulator:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# For physical Android device on the same local Wi-Fi:
# Replace with your machine's IP (e.g. run `ipconfig` in cmd to find IPv4):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000/api/v1

# For cloud production backend:
# EXPO_PUBLIC_API_BASE_URL=https://meditrack-api.example.com/api/v1
